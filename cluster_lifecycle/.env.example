# Copy to .env and fill the target values. Never put private keys in this file.
REGION=eu-frankfurt-1
OCI_CONFIG_FILE=~/.oci/config
OCI_PROFILE=DEFAULT

# Required: exact compartment name or OCID, and exact cluster name.
COMPARTMENT=
CLUSTER_NAME=

# Optional scope: set a workspace name OR key, not both.
AIDP_INSTANCE_ID=
WORKSPACE_NAME=
WORKSPACE_KEY=
# Leave empty for both types; otherwise USER (Spark) or AI_COMPUTE.
CLUSTER_TYPE=

# Safe default; the positional CLI action overrides this setting.
ACTION=status
WAIT=true
WAIT_TIMEOUT=1200
POLL_INTERVAL=10
DRY_RUN=false

# Normally empty: endpoint is derived from REGION using Oracle's SDK template.
AIDP_ENDPOINT=
