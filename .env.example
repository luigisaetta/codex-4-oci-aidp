# Copy to .env and fill the target values. Never put private keys in this file.
REGION=eu-frankfurt-1
OCI_CONFIG_FILE=~/.oci/config
OCI_PROFILE=DEFAULT

# Shared: exact compartment name or OCID and optional instance scope. Prefer an
# OCID to avoid an OCI Identity lookup during initial target resolution.
COMPARTMENT=
AIDP_INSTANCE_ID=

# Cluster lifecycle only: exact cluster name.
CLUSTER_NAME=

# Optional scope: set a workspace name OR key, not both.
WORKSPACE_NAME=
WORKSPACE_KEY=
# Leave empty for both types; otherwise USER (Spark) or AI_COMPUTE.
CLUSTER_TYPE=

# Safe default; the positional CLI action overrides this setting.
ACTION=status
WAIT=true
WAIT_TIMEOUT=1200
POLL_INTERVAL=10
DRY_RUN=false

# Normally empty: endpoint is derived from REGION using Oracle's SDK template.
AIDP_ENDPOINT=
